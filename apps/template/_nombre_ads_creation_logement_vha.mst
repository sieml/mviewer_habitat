{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">			
					<div class="col-xs-2" style="padding-right:0px; padding-left:5px; margin-top:3%;">
						<img class="img-responsive" src="./apps/observatoire_habitat/template/img/habitants.svg" style="max-width:50%;margin: 0 auto;">
						<div class="number" style="margin-top:5%;text-align:center;">{{nb_ads_creation_logement}}</div>
						<div class="title-number" style="text-align:center;">
							<p>Nombre d'ADS avec création de logements</p>
						</div>
						<div class="title-number" style="text-align:center;"">
							<p>{{nb_ads_creation_logement_interco}} pour l'EPCI</p>
						</div>							
					</div>
					<div class="col-xs-2" style="padding-right:0px; padding-left:5px; margin-top:3%;">
						<img class="img-responsive" src="apps/observatoire_habitat/template/img/part.svg" style="max-width:50%;margin: 0 auto;">
						<div class="number" style="margin-top:5%;text-align:center;">{{tx_ads_creation_logement_interco}}%</div>
						<div class="title-number" style="text-align:center;">
							<p>Part des ADS avec création de logement de l'EPCI</p>
						</div>

					</div>					
					
    				<div class="col-xs-4" style="margin-left:3%;">
    					<canvas id="ChartNbAdsCreationLogement"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Nombre d'ADS avec création de logements</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}, {{serie}}</i></br></p></br>
    					</div> 
    				</div>

    				
				</div>
				<div class="row">	
					<div class="title-number" style="text-align:left; padding-left:30px;">
							<p><i style="font-size:10px; text-align:center; font-family:'roboto_regular'; color:#777;">{{nom_officiel}} - {{serie}} - Source : SITADEL</i></p>
						</div>
				</div>

			</div>
		</div>
	</div>

</div>	

{{/features}}
<style>
