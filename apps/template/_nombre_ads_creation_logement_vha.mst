<script>
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}	
	var nb_ads_creation_logement_n0=[];
	{{#features}}
		nb_ads_creation_logement_n0.push('{{nb_ads_creation_logement_n0}}');
	{{/features}}	
	var nb_ads_creation_logement_n1=[];
	{{#features}}
		nb_ads_creation_logement_n1.push('{{nb_ads_creation_logement_n1}}');
	{{/features}}	
	var nb_ads_creation_logement_n2=[];
	{{#features}}
		nb_ads_creation_logement_n2.push('{{nb_ads_creation_logement_n2}}');
	{{/features}}	
	var nb_ads_creation_logement_n3=[];
	{{#features}}
		nb_ads_creation_logement_n3.push('{{nb_ads_creation_logement_n3}}');
	{{/features}}
	var nb_ads_creation_logement_n4=[];
	{{#features}}
		nb_ads_creation_logement_n4.push('{{nb_ads_creation_logement_n4}}');
	{{/features}}	
	var nb_ads_creation_logement_n5=[];
	{{#features}}
		nb_ads_creation_logement_n5.push('{{nb_ads_creation_logement_n5}}');
	{{/features}}	
	var nb_ads_creation_logement_n0_interco=[];
	{{#features}}
		nb_ads_creation_logement_n0_interco.push('{{nb_ads_creation_logement_n0_interco}}');
	{{/features}}	
	var nb_ads_creation_logement_n1_interco=[];
	{{#features}}
		nb_ads_creation_logement_n1_interco.push('{{nb_ads_creation_logement_n1_interco}}');
	{{/features}}	
	var nb_ads_creation_logement_n2_interco=[];
	{{#features}}
		nb_ads_creation_logement_n2_interco.push('{{nb_ads_creation_logement_n2_interco}}');
	{{/features}}	
	var nb_ads_creation_logement_n3_interco=[];
	{{#features}}
		nb_ads_creation_logement_n3_interco.push('{{nb_ads_creation_logement_n3_interco}}');
	{{/features}}
	var nb_ads_creation_logement_n4_interco=[];
	{{#features}}
		nb_ads_creation_logement_n4_interco.push('{{nb_ads_creation_logement_n4_interco}}');
	{{/features}}	
	var nb_ads_creation_logement_n5_interco=[];
	{{#features}}
		nb_ads_creation_logement_n5_interco.push('{{nb_ads_creation_logement_n5_interco}}');
	{{/features}}	
	
	
	
    var indicateurNbAdsCreationLogement = {};
	indicateurNbAdsCreationLogement.getData = function() {
		var data = {ChartNbAdsCreationLogement: {labels:["2020", "2021", "2022" ,"2023","2024"], data: {datasets: [[nb_ads_creation_logement_n4[0],nb_ads_creation_logement_n3[0],nb_ads_creation_logement_n2[0],nb_ads_creation_logement_n1[0],nb_ads_creation_logement_n0[0]],[nb_ads_creation_logement_n4_interco[0],nb_ads_creation_logement_n3_interco[0],nb_ads_creation_logement_n2_interco[0],nb_ads_creation_logement_n1_interco[0],nb_ads_creation_logement_n0_interco[0]]]}}};
		indicateurNbAdsCreationLogement.drawChart(data);
	};

	indicateurNbAdsCreationLogement.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartNbAdsCreationLogement");
			var maxscale = Math.max.apply(this, data.ChartNbAdsCreationLogement.data.datasets[0]) / 5;
			maxscale = Math.trunc(maxscale) * 5;
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartNbAdsCreationLogement = new Chart(ctx2, {
			type: 'bar',
			data: {
				labels: data.ChartNbAdsCreationLogement.labels,
				datasets: [{
							label: nom_officiel,
							backgroundColor: "#518299",
							borderColor: "#518299",
							borderWidth: 1,
							borderSkipped:'left',
							data: data.ChartNbAdsCreationLogement.data.datasets[0]
							},
                            {
							label: 'EPCI',
							backgroundColor: "#93DCEB",
							borderColor: "#93DCEB",
							borderWidth: 1,
							borderSkipped:'left',
							data: data.ChartNbAdsCreationLogement.data.datasets[1]
							}]
			},
			 options: {
				legend: {
					display: true,
				},

				tooltips: {					
					titleFontFamily:"roboto_bold",
					titleFontSize:13,
					bodyFontFamily:"roboto_regular",
					backgroundColor:"rgba(36, 36, 36, 0.85)",
					callbacks: {
						label: function(tooltipItem, data) {
							return parseFloat(data.datasets[0].data[tooltipItem.index]).toFixed(2).toLocaleString() + " ADS avec création de logement";

						}
					}
		        }
			}
			});  
	};
	
	 if  (typeof Chart === 'function') {
			indicateurNbAdsCreationLogement.getData();

    } else {
            $.get('https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js', function() {
				indicateurNbAdsCreationLogement.getData();

            });
	}	
	
</script>	