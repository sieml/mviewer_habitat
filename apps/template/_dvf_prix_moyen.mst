	.title-feature {
		font-family:"roboto_black";
		font-size:23px;
		text-align: left;
		margin-bottom:3%;
		line-height:1;			
	}
	<!-- .indicateurConfLog {			 -->
		<!-- text-align: center; -->
	<!-- } -->
	<!-- .panel-graph { -->
	    <!-- color: #3db39e; -->
	    <!-- text-align: center; -->
	<!-- } -->

	.container_viz{
			padding-left:0!important;
			margin-left:0!important;
			overflow: hidden;
			margin-top: 1%;
		}
	.number{
			font-family: "roboto_black";
			font-size:35px;
			/*margin-top: 5px;*/
		}
	.title-number{
			font-family: "roboto_bold";
			font-size:12px;
			/*margin-top:0%;*/
		}
</style>


<script>
  var nom_officiel = [];
	var chartDataList = {
	  global: null,
	  t1: null,
	  t2: null,
	  t3: null,
	  t4: null,
	  t5: null
	};


  var nbmai1pp = []
  var nbmai2pp = []
  var nbmai3pp = []
  var nbmai4pp = []
  var nbmai5pp = []
  var nbapt1pp = []
  var nbapt2pp = []
  var nbapt3pp = []
  var nbapt4pp = []
  var nbapt5pp = []
	let chartInstance = null;
  {{#features}}
    nom_officiel.push("{{nom_officiel}}");
    nbmai1pp.push("{{nbmai1pp}}");
    nbmai2pp.push("{{nbmai2pp}}");
    nbmai3pp.push("{{nbmai3pp}}");
    nbmai4pp.push("{{nbmai4pp}}");
    nbmai5pp.push("{{nbmai5pp}}");
    nbapt1pp.push("{{nbapt1pp}}");
    nbapt2pp.push("{{nbapt2pp}}");
    nbapt3pp.push("{{nbapt3pp}}");
    nbapt4pp.push("{{nbapt4pp}}");
    nbapt5pp.push("{{nbapt5pp}}");

  try {
    chartDataList.global = JSON.parse('{{{chart_data}}}');
    chartDataList.t1 = JSON.parse('{{{chart_data_t1}}}');
    chartDataList.t2 = JSON.parse('{{{chart_data_t2}}}');
    chartDataList.t3 = JSON.parse('{{{chart_data_t3}}}');
    chartDataList.t4 = JSON.parse('{{{chart_data_t4}}}');
    chartDataList.t5 = JSON.parse('{{{chart_data_t5}}}');
    console.log("chart_data_t1: ", '{{{chart_data_t1}}}');

  } catch (e) {
    console.error("Erreur de parsing des chart_data :", e);
  }

  {{/features}}

  var indicateurPrixMoyen = {};

	var indicateurTypologie = {};
	indicateurTypologie.getData = function() {
		var data = {ChartTypologie: {labels:['T1','T2','T3','T4','T5'], data: {datasets: [[nbmai1pp[0],nbmai2pp[0], nbmai3pp[0],nbmai4pp[0],nbmai5pp[0]],[nbapt1pp[0],nbapt2pp[0],nbapt3pp[0],nbapt4pp[0],nbapt5pp[0]]], skipNull: true }}};
		indicateurTypologie.drawChart(data);
	};


  indicateurPrixMoyen.drawChart = function (data) {
    var ctx3 = document.getElementById("Chart");

    if (!ctx3 || !data) {
      console.warn("Canvas ou données manquantes");
      return;
    }
		if (chartInstance) {
		    chartInstance.destroy();
		    chartInstance = null; // Détruire l'ancien graphique avant de recréer
		  }


     chartInstance = new Chart(ctx3, {
      type: 'line',
      data: data,
      options: {
        responsive: true,
        plugins: {
          title: {
            display: true,
            text: 'Évolution du prix moyen par type de logement'
          }
        },
        scales: {
	        y: {
	          title: {
	            display: true,
	            text: 'Prix moyen (€)'
	          },
	          beginAtZero: false
	        },
	        x: {
	          title: {
	            display: true,
	            text: 'Année'
	          }
	        }
        }
      }
    });
  };


	indicateurTypologie.drawChart = function (data) {
			var ctx2 = document.getElementById("Chart2");
			var maxscale = Math.max.apply(this, data.ChartTypologie.data.datasets[0]) / 5;
			maxscale = Math.trunc(maxscale) * 5;
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartTypologie = new Chart(ctx2, {
			type: 'bar',
			data: {
				labels: data.ChartTypologie.labels,
				datasets: [
				    {
						label: 'Maisons',
						backgroundColor: "#005EA8",
						borderColor: "#005EA8",
						borderWidth: 1,
						data: data.ChartTypologie.data.datasets[0]
			    	},
				    {
						label: 'Appartements',
						backgroundColor: "#64BE53",
						borderColor: "#64BE53",
						borderWidth: 1,
						data: data.ChartTypologie.data.datasets[1]
			    	}
				]
			},
			 options: {
				legend: {
					display: true,
				},
				
	      scales: {
	        x: {
	          stacked: true
	        },
	        y: {
	          stacked: true
	        }
	      }
			}
		});  
	};






  function loadChartLibraryAndDraw(data) {
    if (typeof Chart === 'function') {
      indicateurPrixMoyen.drawChart(data);
      indicateurTypologie.getData()
    } else {
      $.getScript('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function () {
        indicateurPrixMoyen.drawChart(data);
        indicateurTypologie.getData()
      });
    }
  }

  // Exemple : dessiner avec le premier jeu de données s'il existe
  if (chartDataList.global) {
      loadChartLibraryAndDraw(chartDataList.global);
  } else {
    console.warn("Aucune donnée de graphique disponible");
  }


  document.getElementById("typeLogementSelect").addEventListener("change", function () {
  const selectedType = this.value; // "t1", "t2", etc.
  const data = chartDataList[selectedType];

  if (data) {
    indicateurPrixMoyen.drawChart(data);
  } else {
    console.warn("Aucune donnée pour ce type de logement :", selectedType);
  }
});
</script>
	