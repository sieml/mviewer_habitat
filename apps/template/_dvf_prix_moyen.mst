{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">			
					<div class="col-xs-2" style="padding-right:0px; ">
						<div class="row">
							<div class="col-xs-2" style="padding-right:0px;">
								<img src="./apps/template/img/appartement.png" style="width:60px; " title="Cliquez pour agrandir cette image">
							</div>
							<div class="col-xs-8" style="padding-right:0px; margin-left:15%;margin-top:5%;">	
								<div class="number" style="text-align:left;font-size:24px;">
									{{nb_vente_appt}}
								</div>
								<div class="title-number" style="text-align: left;">
        							<p>Appartements vendus</p>
								</div>
								<div class="title-number" style="text-align: left;">
        							<p>{{nb_vente_appt_comp}} pour {{nom_officiel_comp}}</p>
								</div>									
							</div>	
						</div>
            <div class="row">
							<div class="col-xs-2" style="padding-right:0px;">
								<img src="./apps/template/img/maison.png" style="width:60px; " title="Cliquez pour agrandir cette image">
							</div>
							<div class="col-xs-8" style="padding-right:0px; margin-left:15%;margin-top:5%;">	
								<div class="number" style="text-align:left;font-size:24px;">
									{{nb_vente_mai}}
								</div>
								<div class="title-number" style="text-align: left;">
        							<p>Maisons vendues</p>
								</div>								
								<div class="title-number" style="text-align:left;">
									<p>{{nb_vente_mai_comp}} pour {{nom_officiel_comp}}</p>
								</div>	
							</div>
						</div>
					</div>	
					
    				<div class="col-xs-4" style="margin-left:3%;">
    				<div style="text-align: center; margin-bottom: 10px;">
						  <label for="typeLogementSelect"><strong>Type de logement :</strong></label>
						  <select id="typeLogementSelect">
						    <option value="global">Tous logements</option>
						    <option value="t1">T1</option>
						    <option value="t2">T2</option>
						    <option value="t3">T3</option>
						    <option value="t4">T4</option>
						    <option value="t5">T5+</option>
						  </select>
						</div>
    					<canvas id="Chart"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Prix moyen des ventes</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}, {{anneemut}}</i></br></p></br>
    					</div> 
    				</div>
    				<div class="col-xs-4" style="margin-left:3%;">
    					<canvas id="Chart2"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Typologie des ventes</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}, {{anneemut}}</i></br></p></br>
    					</div> 
    				</div>
    				
				</div>
				<div class="row">	
					<div class="title-number" style="text-align:left; padding-left:30px;">
							<p><i style="font-size:10px; text-align:center; font-family:'roboto_regular'; color:#777;">{{nom_officiel}} - {{anneemut}} - Source : DVF</i></p>
						</div>
				</div>

			</div>
		</div>
	</div>

</div>			
{{/features}}


<style>
	<!-- body, html { -->
