	.container_viz{
			padding-left:0!important;
			margin-left:0!important;
			overflow: hidden;
			margin-top: 1%;
		}
	.number{
			font-family: "roboto_black";
			font-size:35px;
			/*margin-top: 5px;*/
		}
	.title-number{
			font-family: "roboto_bold";
			font-size:12px;
			/*margin-top:0%;*/
		}
</style>

<script>

	
	var tx_20m=[];
	{{#features}}
		tx_20m.push('{{tx_20m}}');
	{{/features}}	
	
	var tx_20_64=[];
	{{#features}}
		tx_20_64.push('{{tx_20_64}}');
	{{/features}}	
	
	var tx_65p=[];
	{{#features}}
		tx_65p.push('{{tx_65p}}');
	{{/features}}	

	var tx_20m_comp=[];
	{{#features}}
		tx_20m_comp.push('{{tx_20m_comp}}');
	{{/features}}	
	
	var tx_20_64_comp=[];
	{{#features}}
		tx_20_64_comp.push('{{tx_20_64_comp}}');
	{{/features}}	
	
	var tx_65p_comp=[];
	{{#features}}
		tx_65p_comp.push('{{tx_65p_comp}}');
	{{/features}}	
	
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}
	var nom_officiel_comp=[];
	{{#features}}
		nom_officiel_comp.push('{{nom_officiel_comp}}');
	{{/features}}	

	
	var indicateurPopAge_b = {};
	indicateurPopAge_b.getData = function() {
		var data = {ChartPopAge: {labels:[nom_officiel,nom_officiel_comp], data: {datasets: [[tx_20m[0],tx_20m_comp[0]],[tx_20_64[0],tx_20_64_comp[0]],[tx_65p[0],tx_65p_comp[0]]], skipNull: true }}};
		indicateurPopAge_b.drawChart(data);
	};
    
	indicateurPopAge_b.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartPopAge");
			var maxscale = Math.max.apply(this, data.ChartPopAge.data.datasets[0]) / 5;
			maxscale = Math.trunc(maxscale) * 5;
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartPopAge = new Chart(ctx2, {
			type: 'bar',
			data: {
				labels: data.ChartPopAge.labels,
				datasets: [
				    {
						label: 'Moins de 20 ans',
						backgroundColor: "#005EA8",
						borderColor: "#005EA8",
						borderWidth: 1,
						data: data.ChartPopAge.data.datasets[0]
			    	},
				    {
						label: '20-64 ans',
						backgroundColor: "#64BE53",
						borderColor: "#64BE53",
						borderWidth: 1,
						data: data.ChartPopAge.data.datasets[1]
			    	},
				    {
						label: '65 ans et plus',
						backgroundColor: "#B1DBF2",
						borderColor: "#B1DBF2",
						borderWidth: 1,
						data: data.ChartPopAge.data.datasets[2]
			    	}
			]
			},
			 options: {
			    indexAxis: 'y',
				legend: {
					display: true,
				},
				
                scales: {
                     yAxes: [{
                        stacked: true // this also..
                     }],
                     xAxes: [{
                        stacked: true // this also..
                     }]
                }
			}
		});  
	};
	
	if  (typeof Chart === 'function') {
			indicateurPopAge_b.getData();

    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
				indicateurPopAge_b.getData();

            });
	}	
	
</script>