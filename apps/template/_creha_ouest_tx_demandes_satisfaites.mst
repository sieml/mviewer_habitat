<script>

	
	var tx_attribution=[];
	{{#features}}
		tx_attribution.push('{{tx_attribution}}');
	{{/features}}	


	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}	
	var nom_officiel_comp=[];
	{{#features}}
		nom_officiel_comp.push('{{nom_officiel_comp}}');
	{{/features}}	


	var tx_attribution_comp=[];
	{{#features}}
		tx_attribution_comp.push('{{tx_attribution_comp}}');
	{{/features}}	

	var nb_att_t1=[];
	{{#features}}
		nb_att_t1.push('{{nb_att_t1}}');
	{{/features}}	
	var nb_att_t2=[];
	{{#features}}
		nb_att_t2.push('{{nb_att_t2}}');
	{{/features}}	
	var nb_att_t3=[];
	{{#features}}
		nb_att_t3.push('{{nb_att_t3}}');
	{{/features}}	
	var nb_att_t4=[];
	{{#features}}
		nb_att_t4.push('{{nb_att_t4}}');
	{{/features}}	
	var nb_att_t5plus=[];
	{{#features}}
		nb_att_t5plus.push('{{nb_att_t5plus}}');
	{{/features}}	

	var nb_ddes_t1=[];
	{{#features}}
		nb_ddes_t1.push('{{nb_ddes_t1}}');
	{{/features}}	
	var nb_ddes_t2=[];
	{{#features}}
		nb_ddes_t2.push('{{nb_ddes_t2}}');
	{{/features}}	
	var nb_ddes_t3=[];
	{{#features}}
		nb_ddes_t3.push('{{nb_ddes_t3}}');
	{{/features}}	
	var nb_ddes_t4=[];
	{{#features}}
		nb_ddes_t4.push('{{nb_ddes_t4}}');
	{{/features}}	
	var nb_ddes_t5plus=[];
	{{#features}}
		nb_ddes_t5plus.push('{{nb_ddes_t5plus}}');
	{{/features}}	

	
	{{#features}}
		const chart_data = {{{chart_data}}};
	{{/features}}	
	console.log(chart_data);



	var indicateurTaille = {};
	indicateurTaille.getData = function () {
		var data = {
			ChartTaille: {
				labels: ["T1", "T2", "T3", "T4", "T5+"],
				datasets: [
					[nb_ddes_t1[0], nb_ddes_t2[0], nb_ddes_t3[0], nb_ddes_t4[0], nb_ddes_t5plus[0]],
					[nb_att_t1[0], nb_att_t2[0], nb_att_t3[0], nb_att_t4[0], nb_att_t5plus[0]]
					
				]
			}
		};
		indicateurTaille.drawChart(data);
		console.log("data ChartTaille", data);
	};

	indicateurTaille.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartTaille");
			var maxscale = Math.max.apply(this, data.ChartTaille.datasets[0]) / 5;
			maxscale = Math.trunc(maxscale) * 5;
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartTaille = new Chart(ctx2, {
			type: 'bar',
			data: {
				labels: data.ChartTaille.labels,
				datasets: [
				    {
						label: 'Demandes',
						backgroundColor: "#005EA8",
						borderColor: "#005EA8",
						borderWidth: 1,
						data: data.ChartTaille.datasets[0],
						stack:'Stack 0'
			    	},
				    {
						label: 'Attributions',
						backgroundColor: "#64BE53",
						borderColor: "#64BE53",
						borderWidth: 1,
						data: data.ChartTaille.datasets[1],
						stack:'Stack 1'
			    	},
				]
			},
			 options: {
		      title: {
		        display: true,
		        text: 'Demandes et attributions par typologie des logements'
		      },			 
			}
		});  
	};





	var indicateurEvolDemandesSatisfaites = {};
 	indicateurEvolDemandesSatisfaites.drawChart = function (data) {
			var ctx3 = document.getElementById("ChartEvolDemandesSatisfaites");
			var ChartEvolDemandesSatisfaites = new Chart(ctx3, {
			   type: 'line', // ou 'bar' si tu préfères un histogramme
			    data: chart_data,
				 options: {
				    plugins: {
				      title: {
				        display: true,
				        text: 'Evolution des demandes et attributions de logements sociaux (base 100 en 2021)'
				      },
				    },
				    responsive: true
				  }
			});
	};


	if  (typeof Chart === 'function') {
			indicateurEvolDemandesSatisfaites.drawChart();
			indicateurTaille.getData()

    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js', function() {
				indicateurEvolDemandesSatisfaites.drawChart();
				indicateurTaille.getData()
            });
	}	




</script>