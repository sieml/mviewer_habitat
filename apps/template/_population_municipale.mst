	.title-feature {
		color: #2F4455;
		font-family:"roboto_black";
		font-size:23px;
		text-align: left;
		margin-bottom:3%;
		line-height:1;			
	}
	<!-- .indicateurConfLog {			 -->
		<!-- text-align: center; -->
	<!-- } -->
	<!-- .panel-graph { -->
	    <!-- color: #3db39e; -->
	    <!-- text-align: center; -->
	<!-- } -->

	.container_viz{
			padding-left:0!important;
			margin-left:0!important;
			overflow: hidden;
			margin-top: 1%;
		}
	.number{
			font-family: "roboto_black";
			font-size:35px;
			color: #354753;
			/*margin-top: 5px;*/
		}
	.title-number{
			font-family: "roboto_bold";
			font-size:12px;
			color: #518299;
			/*margin-top:0%;*/
		}
</style>

<script>

	
	var tx_25m=[];
	{{#features}}
		tx_25m.push('{{tx_25m}}');
	{{/features}}	
	
	var tx_25_64=[];
	{{#features}}
		tx_25_64.push('{{tx_25_64}}');
	{{/features}}	
	
	var tx_65p=[];
	{{#features}}
		tx_65p.push('{{tx_65p}}');
	{{/features}}	

	var tx_25m_interco=[];
	{{#features}}
		tx_25m_interco.push('{{tx_25m_interco}}');
	{{/features}}	
	
	var tx_25_64_interco=[];
	{{#features}}
		tx_25_64_interco.push('{{tx_25_64_interco}}');
	{{/features}}	
	
	var tx_65p_interco=[];
	{{#features}}
		tx_65p_interco.push('{{tx_65p_interco}}');
	{{/features}}	
	
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}
	

	
	var indicateurPopAge_b = {};
	indicateurPopAge_b.getData = function() {
		var data = {ChartPopAge: {labels:[nom_officiel,"EPCI"], data: {datasets: [[tx_25m[0],tx_25m_interco[0]],[tx_25_64[0],tx_25_64_interco[0]],[tx_65p[0],tx_65p_interco[0]]], skipNull: true }}};
		indicateurPopAge_b.drawChart(data);
	};
    
	indicateurPopAge_b.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartPopAge");
			var maxscale = Math.max.apply(this, data.ChartPopAge.data.datasets[0]) / 5;
			maxscale = Math.trunc(maxscale) * 5;
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartPopAge = new Chart(ctx2, {
			type: 'horizontalBar',
			data: {
				labels: data.ChartPopAge.labels,
				datasets: [
				    {
						label: 'Moins de 25 ans',
						backgroundColor: "#f1946d",
						borderColor: "#f1946d",
						borderWidth: 1,
						data: data.ChartPopAge.data.datasets[0]
			    	},
				    {
						label: '25-64 ans',
						backgroundColor: "#518299",
						borderColor: "#518299",
						borderWidth: 1,
						data: data.ChartPopAge.data.datasets[1]
			    	},
				    {
						label: '65 ans et plus',
						backgroundColor: "#93dceb",
						borderColor: "#93dceb",
						borderWidth: 1,
						data: data.ChartPopAge.data.datasets[2]
			    	}
			]
			},
			 options: {
			    indexAxis: 'y',
				legend: {
					display: true,
				},
				
                scales: {
                     yAxes: [{
                        stacked: true // this also..
                     }],
                     xAxes: [{
                        stacked: true // this also..
                     }]
                }
			}
		});  
	};
	
	if  (typeof Chart === 'function') {
			indicateurPopAge_b.getData();

    } else {
            $.get('https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js', function() {
				indicateurPopAge_b.getData();

            });
	}	
	
</script>