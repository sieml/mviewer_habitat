{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">
				
					<div class="col-xs-2" style="padding-right:0px; ">
						<div class="row">
							<div class="col-xs-2" style="padding-right:0px;">
								<img src="./apps/template/img/habitants.svg" style="width:60px; " title="Cliquez pour agrandir cette image">
							</div>
							<div class="col-xs-8" style="padding-right:0px; margin-left:15%;margin-top:5%;">	
								<div class="number" style="text-align:left; color:#354753;font-size:24px;">
									{{popmunicipale}}
								</div>
								<div class="title-number" style="text-align: left;color:#518299;">
        							<p>Population municipale</p>
								</div>
								<div class="title-number" style="text-align: left;color:#354753;">
        							<p>{{popmunicipale_interco}} pour l'EPCI</p>
								</div>									
							</div>	
						</div>
                        <div class="row">
							<div class="col-xs-2" style="padding-right:0px;">
								<img src="./apps/template/img/part.svg" style="width:60px; " title="Cliquez pour agrandir cette image">
							</div>
							<div class="col-xs-8" style="padding-right:0px; margin-left:15%;margin-top:5%;">	
								<div class="number" style="text-align:left; color:#354753;font-size:24px;">
									{{tx_popmunicipale_interco}}%
								</div>
								<div class="title-number" style="text-align:left; color:#518299;">
									<p>Part de la population de l'EPCI</p>
								</div>	
							</div>
						</div>
					</div>				
				
				
					<div class="col-xs-2" >
						<img class="img-responsive" src="./apps/template/img/habitants.svg" style="max-width:50%;margin: 0 auto;">
						<div class="number" style="margin-top:5%;text-align:center;">{{densitepopulation}}</div>
						<div class="title-number" style="text-align:center;">
							<p>Densité de population (hab/km²)</p>
						</div>
					</div>
					
    				<div class="col-xs-4" >
    					<canvas id="ChartPopAge"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Répartition de la population selon la catégorie d'âge</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}, {{serie}}</i></br></p></br>
    					</div> 
    				</div>

    				
				</div>
				<div class="row">	
					<div class="title-number" style="text-align:left; padding-left:30px;">
							<p><i style="font-size:10px; text-align:center; font-family:'roboto_regular'; color:#777;">{{nom_officiel}} - {{serie}} - Source : INSEE RP</i></p>
						</div>
				</div>

			</div>
		</div>
	</div>

</div>	

{{/features}}

<style>
