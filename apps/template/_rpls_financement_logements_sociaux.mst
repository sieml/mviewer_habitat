{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">			

    				<div class="col-xs-4" >
    					<canvas id="ChartFinancementLogSociaux"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Financement des logements sociaux</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}, {{millesime}}</i></br></p></br>
    					</div> 
    				</div>

				</div>
				<div class="row">	
					<div class="title-number" style="text-align:left; padding-left:30px;">
							<p><i style="font-size:10px; text-align:center; font-family:'roboto_regular'; color:#777;">{{nom_officiel}} - {{millesime}} - Source : RPLS</i></p>
						</div>
				</div>

			</div>
		</div>
	</div>

</div>	

{{/features}}

