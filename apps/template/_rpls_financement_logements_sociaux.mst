</style>

<script>
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}	
	
	
	var nb_plai=[];
	{{#features}}
		nb_plai.push('{{nb_plai}}');
	{{/features}}	
	
	var nb_plus=[];
	{{#features}}
		nb_plus.push('{{nb_plus}}');
	{{/features}}	

	var nb_pls=[];
	{{#features}}
		nb_pls.push('{{nb_pls}}');
	{{/features}}	

	var nb_pli=[];
	{{#features}}
		nb_pli.push('{{nb_pli}}');
	{{/features}}
	var nb_autre_finan=[];
	{{#features}}
		nb_autre_finan.push('{{nb_autre_finan}}');
	{{/features}}	

	var indicateurFinancementLogementsSociaux = {};
	indicateurFinancementLogementsSociaux.getData = function() {
		var data = {ChartFinancementLogSociaux: {labels:['PLAI','PLUS','PLS','PLI','Autre'], data: {datasets: [[nb_plai[0],nb_plus[0], nb_pls[0], nb_pli[0], nb_autre_finan[0]]]}}};
		indicateurFinancementLogementsSociaux.drawChart(data);
	};

	indicateurFinancementLogementsSociaux.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartFinancementLogSociaux");
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartFinancementLogSociaux = new Chart(ctx2, {
			type: 'bar',
			data: {
				labels: data.ChartFinancementLogSociaux.labels,
				datasets: [{
							label: 'Nombre de logements',
							backgroundColor: "#518299",
							borderColor: "#518299",
							borderWidth: 1,
							borderSkipped:'left',
							data: data.ChartFinancementLogSociaux.data.datasets[0]
							}]
			},
			options: {
			    responsive: true,
			    scales: {
			        y: {
			            ticks: {
			                precision: 0
			            }
			        }
			    }
			}
		});  
	};


	if  (typeof Chart === 'function') {
			indicateurFinancementLogementsSociaux.getData();

    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
				indicateurFinancementLogementsSociaux.getData();
            });
	}	
	
</script>