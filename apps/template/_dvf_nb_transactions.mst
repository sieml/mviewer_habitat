    var indicateurNbTransactions = {};
	indicateurNbTransactions.getData = function() {
		var data = {ChartNbTransactions: {labels:["N-5","N-4", "N-3", "N-2" ,"N-1","N0"], data: {datasets: [
		    [nb_vente_appt_n5[0],nb_vente_appt_n4[0],nb_vente_appt_n3[0],nb_vente_appt_n2[0],nb_vente_appt_n1[0],nb_vente_appt_n0[0]],
		    [nb_vente_mai_n5[0] ,nb_vente_mai_n4[0],nb_vente_mai_n3[0],nb_vente_mai_n2[0],nb_vente_mai_n1[0],nb_vente_mai_n0[0]],
		    [nb_vente_appt_n5_interco[0],nb_vente_appt_n4_interco[0],nb_vente_appt_n3_interco[0],nb_vente_appt_n2_interco[0],nb_vente_appt_n1_interco[0],nb_vente_appt_n0_interco[0]],
		    [nb_vente_mai_n5_interco[0] ,nb_vente_mai_n4_interco[0],nb_vente_mai_n3_interco[0],nb_vente_mai_n2_interco[0],nb_vente_mai_n1_interco[0],nb_vente_mai_n0_interco[0]],
		]}}};
		indicateurNbTransactions.drawChart(data);
		console.log(data)
	};
    
	indicateurNbTransactions.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartNbTransactions");
			var maxscale = Math.max.apply(this, data.ChartNbTransactions.data.datasets[0]) / 5;
			maxscale = Math.trunc(maxscale) * 5;
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartNbTransactions = new Chart(ctx2, {
			type: 'bar',
			data: {
				labels: data.ChartNbTransactions.labels,
				datasets: [
				    {
						label: nom_officiel + ' (appartement)',
						backgroundColor: "#518299",
						data: data.ChartNbTransactions.data.datasets[0],
						stack:'Stack 0'
				    },
                    {
						label: nom_officiel + ' (maison)',
						backgroundColor: "#93DCEB",
						data: data.ChartNbTransactions.data.datasets[1],
						stack:'Stack 0'
					},
				    {
						label: 'EPCI (appartement)',
						backgroundColor: "#518299",
						data: data.ChartNbTransactions.data.datasets[2],
						stack:'Stack 1'
				    },
                    {
						label: 'EPCI (maison)',
						backgroundColor: "#93DCEB",
						data: data.ChartNbTransactions.data.datasets[3],
						stack:'Stack 1'
					},					
				]
			},
			 options: {
				legend: {
					display: false,
				},
                scales: {
                     yAxes: [{
                        stacked: true // this also..
                     }]
                },

			}
		});  
	};
	
	 if  (typeof Chart === 'function') {
			indicateurNbTransactions.getData();

    } else {
            $.get('https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js', function() {
				indicateurNbTransactions.getData();

            });
	}	
	
</script>	