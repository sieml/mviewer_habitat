<script>
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}	
	var nb_vente=[];
	{{#features}}
		nb_vente.push('{{nb_vente}}');
	{{/features}}		
	
	var avg_prix_tab_n0=[];
	{{#features}}
		avg_prix_tab_n0.push('{{avg_prix_tab_n0}}');
	{{/features}}	
	var avg_prix_tab_n1=[];
	{{#features}}
		avg_prix_tab_n1.push('{{avg_prix_tab_n1}}');
	{{/features}}	
	var avg_prix_tab_n2=[];
	{{#features}}
		avg_prix_tab_n2.push('{{avg_prix_tab_n2}}');
	{{/features}}	
	var avg_prix_tab_n3=[];
	{{#features}}
		avg_prix_tab_n3.push('{{avg_prix_tab_n3}}');
	{{/features}}
	var avg_prix_tab_n4=[];
	{{#features}}
		avg_prix_tab_n4.push('{{avg_prix_tab_n4}}');
	{{/features}}	
	var avg_prix_tab_n5=[];
	{{#features}}
		avg_prix_tab_n5.push('{{avg_prix_tab_n5}}');
	{{/features}}	
	

		
	var avg_prix_tab_n0_interco=[];
	{{#features}}
		avg_prix_tab_n0_interco.push('{{avg_prix_tab_n0_interco}}');
	{{/features}}	
	var avg_prix_tab_n1_interco=[];
	{{#features}}
		avg_prix_tab_n1_interco.push('{{avg_prix_tab_n1_interco}}');
	{{/features}}	
	var avg_prix_tab_n2_interco=[];
	{{#features}}
		avg_prix_tab_n2_interco.push('{{avg_prix_tab_n2_interco}}');
	{{/features}}	
	var avg_prix_tab_n3_interco=[];
	{{#features}}
		avg_prix_tab_n3_interco.push('{{avg_prix_tab_n3_interco}}');
	{{/features}}
	var avg_prix_tab_n4_interco=[];
	{{#features}}
		avg_prix_tab_n4_interco.push('{{avg_prix_tab_n4_interco}}');
	{{/features}}	
	var avg_prix_tab_n5_interco=[];
	{{#features}}
	    avg_prix_tab_n5_interco.push('{{avg_prix_tab_n5_interco}}');
	{{/features}}	
	
	
	console.log(avg_prix_tab_n5)
    var indicateurPrixTab = {};
	indicateurPrixTab.getData = function() {
		var data = {ChartAvgPrixTab: {labels:["N-5","N-4", "N-3", "N-2" ,"N-1","N0"], data: {datasets: [
		    [avg_prix_tab_n5[0] ,avg_prix_tab_n4[0],avg_prix_tab_n3[0],avg_prix_tab_n2[0],avg_prix_tab_n1[0],avg_prix_tab_n0[0]],
		    [avg_prix_tab_n5_interco[0] ,avg_prix_tab_n4_interco[0],avg_prix_tab_n3_interco[0],avg_prix_tab_n2_interco[0],avg_prix_tab_n1_interco[0],avg_prix_tab_n0_interco[0]],
		]}}};
		indicateurPrixTab.drawChart(data);
	};
    
	indicateurPrixTab.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartAvgPrixTab");
			var maxscale = Math.max.apply(this, data.ChartAvgPrixTab.data.datasets[0]) / 5;
			maxscale = Math.trunc(maxscale) * 5;
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartAvgPrixTab = new Chart(ctx2, {
			type: 'line',
			data: {
				labels: data.ChartAvgPrixTab.labels,
				datasets: [
				    {
						label: nom_officiel,
						borderColor: "rgb(81, 130, 153)",
						backgroundColor:"rgb(81, 130, 153,0.15)",
						borderWidth: '2',
						data: data.ChartAvgPrixTab.data.datasets[0],
						stack:'Stack 0'
				    },
                    {
						label: 'EPCI',
						borderColor: "rgb(147, 220, 235)",
						backgroundColor:"rgb(147, 220, 235,0.15)",
						borderWidth: '2',
						data: data.ChartAvgPrixTab.data.datasets[1],
						stack:'Stack 0'
					}
				]
			},
			 options: {
				legend: {
					display: false,
				},
                scales: {
                     yAxes: [{
                        stacked: false // this also..
                     }]
                },

			}
		});  
	};
	
	 if  (typeof Chart === 'function') {
			indicateurPrixTab.getData();

    } else {
            $.get('https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.5.0/Chart.min.js', function() {
				indicateurPrixTab.getData();

            });
	}	
	
</script>	