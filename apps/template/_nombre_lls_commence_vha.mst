{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">			
					<div class="col-xs-2" style="padding-right:0px; padding-left:5px; margin-top:3%;">

						<div class="row">
							<div class="col-xs-2" style="padding-right:0px;">
								<img src="./apps/template/img/construction.png" style="width:60px; " title="Cliquez pour agrandir cette image">
							</div>
							<div class="col-xs-8" style="padding-right:0px; margin-left:15%;margin-top:5%;">	
								<div class="number" style="text-align:left;font-size:24px;">
									{{nb_lls}}
								</div>
								<div class="title-number" style="text-align: left;">
        							<p>Nombre de logements sociaux commencés</p>
								</div>
								<div class="title-number" style="text-align: left;">
        							<p>{{nb_lls_epci}} pour {{nom_officiel_epci}}</p>
								</div>									
							</div>	
						</div>
					</div>	

    				<div class="col-xs-4" style="margin-left:3%;">
    					<canvas id="ChartNbLogementCommence"></canvas>
    					<div style="margin-top:10px; text-align:center">
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><i>A {{nom_officiel}} en {{annee}}</i></br></p></br>
    					</div> 
    				</div>
    			</div>
			<div class="row">	
				<div class="title-number" style="text-align:left; padding-left:30px;">
					<p><i style="font-size:10px; text-align:center; font-family:'roboto_regular'; color:#777;">{{nom_officiel}} - {{annee}} - Source : SITADEL</i></p>
				</div>
			</div>

		</div>
	</div>

</div>		
{{/features}}


<style>
	<!-- body, html { -->
