			<!-- font-family: "roboto_bold"; -->
			<!-- src: url('fonts/Roboto/Roboto-Bold.ttf'); -->
		<!-- } -->
		<!-- @font-face { -->
			<!-- font-family: "roboto_regular"; -->
			<!-- src: url('fonts/Roboto/Roboto-Regular.ttf'); -->
		<!-- } 		 -->
	.title-feature {
		font-family:"roboto_black";
		font-size:23px;
		text-align: left;
		margin-bottom:3%;
		line-height:1;			
	}
	<!-- .indicateurConfLog {			 -->
		<!-- text-align: center; -->
	<!-- } -->
	<!-- .panel-graph { -->
	    <!-- color: #3db39e; -->
	    <!-- text-align: center; -->
	<!-- } -->

	.container_viz{
			padding-left:0!important;
			margin-left:0!important;
			overflow: hidden;
			margin-top: 1%;
		}
	.number{
			font-family: "roboto_black";
			font-size:35px;
			/*margin-top: 5px;*/
		}
	.title-number{
			font-family: "roboto_bold";
			font-size:12px;
			/*margin-top:0%;*/
		}
</style>

<script>
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}	
	var nb_logement_commence_epci=[];
	{{#features}}
		nb_logement_commence_epci.push('{{nb_logement_commence_epci}}');
	{{/features}}		
	
	
	{{#features}}
		const chart_data_lls = {{{chart_data_lls}}};
	{{/features}}	
    var indicateurNbLogementCommence = {};
	indicateurNbLogementCommence.drawChart = function (data) {
	    var ctx2 = document.getElementById("ChartNbLogementCommence");
	        
	    var ChartNbLogementCommence = new Chart(ctx2, {
	      type: 'bar', // type principal
	      data: chart_data_lls,
	      options: {
	        responsive: true,
	        interaction: {
	          mode: 'index',
	          intersect: false
	        },
	        scales: {
	          x: {
	            stacked: true
	          },
	          y: {
	            type: 'linear',
	            display: true,
	            position: 'left',
	            stacked: true,
	            beginAtZero: true
	          },

	          /*  
	          // ---- Axe secondaire y1 (désactivé temporairement) ----
	          y1: {  
	            type: 'linear',
	            display: true,
	            position: 'right',
	            grid: {
	              drawOnChartArea: false, 
	            },
	            beginAtZero: true,
	            stacked: false
	          }
	          */

	        },
	        plugins: {
	          legend: {
	            display: true
	          },
	          tooltip: {
	            enabled: true
	          }
	        }
	      }
	    });
	}
	 if  (typeof Chart === 'function') {
			indicateurNbLogementCommence.drawChart();

    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
				indicateurNbLogementCommence.drawChart();

            });
	}	
	
</script>	