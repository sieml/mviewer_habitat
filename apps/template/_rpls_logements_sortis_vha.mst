<script>
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
        const chart_data = {{{chart_data_tab}}};

	{{/features}}	
	



	var chartInstance = null;
	  var indicateurVacance = {};
	  indicateurVacance.drawChart = function (data) {
	    var ctx3 = document.getElementById("ChartVacance");

	    if (!ctx3 || !data) {
	      console.warn("Canvas ou données manquantes");
	      return;
	    }
	    if (chartInstance) {
	        chartInstance.destroy();
	        chartInstance = null; // Détruire l'ancien graphique avant de recréer
	      }


	     chartInstance = new Chart(ctx3, {
	      type: 'line',
	      data: data,
	      options: {
	        responsive: true,
	        plugins: {
	          title: {
	            display: true,
	            text: 'Nombre de logements sortis du parc social'
	          }
	        },
	      }
	    });
	  };




	if  (typeof Chart === 'function') {
			indicateurVacance.drawChart(chart_data)

    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
				indicateurVacance.drawChart(chart_data)
            });
	}	
	
</script>