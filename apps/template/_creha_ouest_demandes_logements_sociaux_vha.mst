{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">			


					<div class="col-xs-2" style="padding-right:0px; padding-left:5px; margin-top:3%;">
						<img class="img-responsive" src="./apps/template/img/pensee.png" style="max-width:50%;margin: 0 auto;">
						<div class="number" style="margin-top:5%;text-align:center;">{{nb_menages}}</div>
						<div class="title-number" style="text-align:center;overflow-wrap: break-word; word-wrap: break-word;">
							<p>Nombre de demandes de logements sociaux au 1er janvier (choix n°1)</p>
						</div>


					</div>


					<div class="col-xs-4" style="height: 225px; position: relative;">
						<canvas id="ChartProfilMenages" style="height: 100%; width: 100%;" ></canvas>
						<div style="margin-top:10px; text-align:center">
						    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Profil des ménages</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}, {{millesime}}</i></br></p></br>						    
						</div> 
					</div>

					<div class="col-xs-4" style="height: 250px; position: relative;">
						<canvas id="ChartEvolMenages" style="height: 100%; width: 100%;" ></canvas>
						<div style="margin-top:10px; text-align:center">
						    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Profil des ménages</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}</i></br></p></br>						    
						</div> 
					</div>

				</div>
				<div class="row">	
					<div class="title-number" style="text-align:left; padding-left:30px;">
							<p><i style="font-size:10px; text-align:center; font-family:'roboto_regular'; color:#777;">{{nom_officiel}} - {{millesime}} - Source : CREHA OUEST</i></p>
						</div>
				</div>

			</div>
		</div>
	</div>

</div>	

{{/features}}

