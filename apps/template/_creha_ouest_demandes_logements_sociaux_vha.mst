<script>

	
	var nb_pers_seule=[];
	{{#features}}
		nb_pers_seule.push('{{nb_pers_seule}}');
	{{/features}}	

	var nb_pers_seule_comp=[];
	{{#features}}
		nb_pers_seule_comp.push('{{nb_pers_seule_comp}}');
	{{/features}}	

	var nb_fam_monop=[];
	{{#features}}
		nb_fam_monop.push('{{nb_fam_monop}}');
	{{/features}}	

	var nb_fam_monop_comp=[];
	{{#features}}
		nb_fam_monop_comp.push('{{nb_fam_monop_comp}}');
	{{/features}}	

	var nb_couple_av_enf=[];
	{{#features}}
		nb_couple_av_enf.push('{{nb_couple_av_enf}}');
	{{/features}}	

	var nb_couple_av_enf_comp=[];
	{{#features}}
		nb_couple_av_enf_comp.push('{{nb_couple_av_enf_comp}}');
	{{/features}}	

	var nb_couple_ss_enf=[];
	{{#features}}
		nb_couple_ss_enf.push('{{nb_couple_ss_enf}}');
	{{/features}}	

	var nb_couple_ss_enf_comp=[];
	{{#features}}
		nb_couple_ss_enf_comp.push('{{nb_couple_ss_enf_comp}}');
	{{/features}}	

	var nb_autre_sit_fam=[];
	{{#features}}
		nb_autre_sit_fam.push('{{nb_autre_sit_fam}}');
	{{/features}}	

	var nb_autre_sit_fam_comp=[];
	{{#features}}
		nb_autre_sit_fam_comp.push('{{nb_autre_sit_fam_comp}}');
	{{/features}}	


	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}	
	var nom_officiel_comp=[];
	{{#features}}
		nom_officiel_comp.push('{{nom_officiel_comp}}');
	{{/features}}	


	var tx_demandes_comp=[];
	{{#features}}
		tx_demandes_comp.push('{{tx_demandes_comp}}');
	{{/features}}	


	
	{{#features}}
		const chart_data = {{{chart_data}}};
	{{/features}}	
	console.log(chart_data);

	var indicateurTypologieDemandes = {};

	indicateurTypologieDemandes.getData = function() {
		var data =  {
		  labels: ['Personne seule', 'Famille monoparentale', 'Couple sans enfant', 'Couple avec enfant', 'Autres',
		           'Personne seule (EPCI)', 'Famille monoparentale (EPCI)', 'Couple sans enfant (EPCI)', 'Couple avec enfant (EPCI)', 'Autres (EPCI)'],
		  datasets: [
		    {
		      backgroundColor: ['#005EA8', '#0089A8', '#1BB7E3', '#7DCBE3', '#7E969E'],
		      data: [nb_pers_seule, nb_fam_monop, nb_couple_ss_enf, nb_couple_av_enf, nb_autre_sit_fam]
		    },
		    {
		      backgroundColor: ['#406E38', '#64BE53', '#93E381', '#CBE3C3', '#878F85'],
		      data: [nb_pers_seule_comp, nb_fam_monop_comp, nb_couple_ss_enf_comp, nb_couple_av_enf_comp, nb_autre_sit_fam_comp]
		    }
		  ]
		};
		indicateurTypologieDemandes.drawChart(data);
	};


	indicateurTypologieDemandes.drawChart = function (data) {
	    var ctx2 = document.getElementById("ChartProfilMenages");

	    var ChartProfilDemandeurs = new Chart(ctx2, {
		  type: 'pie',
		  data: data,
		  options: {
		    responsive: true,
		    maintainAspectRatio: false, // important !
		    plugins: {
		      legend: {
		      	position:'right',
		        labels: {
		          generateLabels: function(chart) {
		            const original = Chart.overrides.pie.plugins.legend.labels.generateLabels;
		            const labelsOriginal = original.call(this, chart);
		            let datasetColors = chart.data.datasets.map(d => d.backgroundColor).flat();
		            
		            labelsOriginal.forEach(label => {
		              label.datasetIndex = Math.floor(label.index / (chart.data.datasets[0].data.length));
		              label.hidden = !chart.isDatasetVisible(label.datasetIndex);
		              label.fillStyle = datasetColors[label.index];
		            });
		            return labelsOriginal;
		          }, 

			      font: {
			          size: 10 // Taille de police réduite
			        },
			        boxWidth: 10, // Réduit la taille des carrés de légende
			        padding: 5 // Moins d'espace autour
					          
		        },
		        onClick: function(_, legendItem, legend) {
		          const ci = legend.chart;
		          ci.getDatasetMeta(legendItem.datasetIndex).hidden = !ci.isDatasetVisible(legendItem.datasetIndex);
		          ci.update();
		        }
		      },
		      tooltip: {
		        callbacks: {
		          title: function(context) {
		            const idx = context[0].datasetIndex;
		            const dataIndex = context[0].dataIndex;
		            const label = data.labels[idx * data.datasets[0].data.length + dataIndex];
		            return label + ': ' + context[0].formattedValue;
		          }
		        }
		      }
		    }
		  }
		});
	};


	var indicateurEvolMenages = {};
 	indicateurEvolMenages.drawChart = function (data) {
			var ctx3 = document.getElementById("ChartEvolMenages");
			var ChartEvolMenages = new Chart(ctx3, {
			   type: 'bar', // ou 'bar' si tu préfères un histogramme
			    data: chart_data,
				 options: {
				    plugins: {
				      title: {
				        display: true,
				        text: 'Evolution de la structure des ménages'
				      },

				    legend: {
				      labels: {
				        font: {
				          size: 10 // Taille de police réduite
				        },
				        boxWidth: 10, // Réduit la taille des carrés de légende
				        padding: 5 // Moins d'espace autour
				      }
				    }				      ,
				    responsive: true,
				    scales: {
				      x: {
				        stacked: true,
				      },
				      y: {
				        stacked: true
				      }
				    }
				  }
				}
			});
	};


	if  (typeof Chart === 'function') {
			indicateurTypologieDemandes.getData();
			indicateurEvolMenages.drawChart();

    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js', function() {
				indicateurTypologieDemandes.getData();
				indicateurEvolMenages.drawChart();
            });
	}	
</script>