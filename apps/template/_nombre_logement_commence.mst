{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">			
					<div class="col-xs-2" style="padding-right:0px; padding-left:5px; margin-top:3%;">

						<div class="row">
							<div class="col-xs-2" style="padding-right:0px;">
								<img src="./apps/template/img/construction.png" style="width:60px; " title="Cliquez pour agrandir cette image">
							</div>
							<div class="col-xs-8" style="padding-right:0px; margin-left:15%;margin-top:5%;">	
								<div class="number" style="text-align:left;font-size:24px;">
									{{nb_logement_commence}}
								</div>
								<div class="title-number" style="text-align: left;">
        							<p>Nombre de logements commencés</p>
								</div>
								<div class="title-number" style="text-align: left;">
        							<p>{{nb_logement_commence_epci}} pour {{nom_officiel_epci}}</p>
								</div>									
							</div>	
						</div>
                  		<div class="row">
							<div class="col-xs-2" style="padding-right:0px;">
								<img src="./apps/template/img/part.png" style="width:60px; " title="Cliquez pour agrandir cette image">
							</div>
							<div class="col-xs-8" style="padding-right:0px; margin-left:15%;margin-top:5%;">	
								<div class="number" style="text-align:left;font-size:24px;">
									{{tx_nb_lgt_tot_crees_epci}}%
								</div>
								<div class="title-number" style="text-align:left;">
									<p>Part des logements commencés de l'EPCI {{nom_officiel_epci}}</p>
								</div>	
							</div>
						</div>

					</div>	

    				<div class="col-xs-4" style="margin-left:3%;">
    					<canvas id="ChartNbLogementCommence"></canvas>
    					<div style="margin-top:10px; text-align:center">
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><i>A {{nom_officiel}} en {{annee}}</i></br></p></br>
    					</div> 
    				</div>

					  <div class="col-xs-3">
					    <div style="font-family:'roboto_bold'; font-size:14px; margin-bottom:5px;">Répartition des logements par superficie de terrain</div>
					    <table class="table table-bordered table-condensed" style="font-size:11px; width:100%;">
					      <thead style="background-color:#f0f4f7; font-family:'roboto_bold'">
					        <tr>
					          <th style="text-align:left;">Superficie du terrain</th>
					          <th style="text-align:right;">Nombre de logements</th>
					        </tr>
					      </thead>
					      <tbody>
					        <tr>
					          <td>< 500 m²</td>
					          <td style="text-align:right;">{{nb_logement_st_500}}</td>
					        </tr>
					        <tr>
					          <td>500 – 800 m²</td>
					          <td style="text-align:right;">{{nb_logement_st_500_800}}</td>
					        </tr>
					        <tr>
					          <td>800 – 1200 m²</td>
					          <td style="text-align:right;">{{nb_logement_st_800_1200}}</td>
					        </tr>
					        <tr>
					          <td>1200 – 2000 m²</td>
					          <td style="text-align:right;">{{nb_logement_st_1200_2000}}</td>
					        </tr>
					        <tr>
					          <td>> 2000 m²</td>
					          <td style="text-align:right;">{{nb_logement_st_2000}}</td>
					        </tr>
					      </tbody>
					    </table>
					  </div>
				



					  <div class="col-xs-2">
					    <div style="font-family:'roboto_bold'; font-size:14px; margin-bottom:5px;">Répartition des logements par superficie</div>
					    <table class="table table-bordered table-condensed" style="font-size:11px; width:100%;">
					      <thead style="background-color:#f0f4f7; font-family:'roboto_bold'">
					        <tr>
					          <th style="text-align:left;">Superficie habitable</th>
					          <th style="text-align:right;">Nombre de logements</th>
					        </tr>
					      </thead>
					      <tbody>
					        <tr>
					          <td>< 50 m²</td>
					          <td style="text-align:right;">{{nb_logement_s_50}}</td>
					        </tr>
					        <tr>
					          <td>50 – 80 m²</td>
					          <td style="text-align:right;">{{nb_logement_s_50_80}}</td>
					        </tr>
					        <tr>
					          <td>80 – 120 m²</td>
					          <td style="text-align:right;">{{nb_logement_s_80_120}}</td>
					        </tr>
					        <tr>
					          <td>120 – 200 m²</td>
					          <td style="text-align:right;">{{nb_logement_s_120_200}}</td>
					        </tr>
					        <tr>
					          <td>> 200 m²</td>
					          <td style="text-align:right;">{{nb_logement_s_200}}</td>
					        </tr>
					      </tbody>
					    </table>
					  </div>
					</div>
				</div>


				<div class="row">	
					<div class="title-number" style="text-align:left; padding-left:30px;">
							<p><i style="font-size:10px; text-align:center; font-family:'roboto_regular'; color:#777;">{{nom_officiel}} - {{annee}} - Source : SITADEL</i></p>
						</div>
				</div>

			</div>
		</div>
	</div>

</div>		
{{/features}}


