	.container_viz{
			padding-left:0!important;
			margin-left:0!important;
			overflow: hidden;
			margin-top: 1%;
		}
	.number{
			font-family: "roboto_black";
			font-size:35px;
			/*margin-top: 5px;*/
		}
	.title-number{
			font-family: "roboto_bold";
			font-size:12px;
			/*margin-top:0%;*/
		}
</style>

<script>
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}	
	var nb_logement_commence_epci=[];
	{{#features}}
		nb_logement_commence_epci.push('{{nb_logement_commence_epci}}');
	{{/features}}		
	
	
	{{#features}}
		const chart_data = {{{chart_data}}};
	{{/features}}	
	console.log(chart_data);
    var indicateurNbLogementCommence = {};
	indicateurNbLogementCommence.drawChart = function (data) {
		var ctx2 = document.getElementById("ChartNbLogementCommence");
			
		var ChartNbLogementCommence = new Chart(ctx2, {
		  type: 'bar', // type principal
		  data: chart_data,
		  options: {
		    responsive: true,
		    interaction: {
		      mode: 'index',
		      intersect: false
		    },
		    scales: {
		      x: {
		        stacked: true
		      },
		      y: {
		        type: 'linear',
		        display: true,
		        position: 'left',
		        stacked: true,
		        beginAtZero: true
		      },
		      y1: {  // axe y secondaire pour la ligne
		        type: 'linear',
		        display: true,
		        position: 'right',
		        grid: {
		          drawOnChartArea: false, // évite lignes de grille sur y1
		        },
		        beginAtZero: true,
		        stacked: false
		      }
		    },
		    plugins: {
		      legend: {
		        display: true
		      },
		      tooltip: {
		        enabled: true
		      }
		    }
		  }
		});
	}
	 if  (typeof Chart === 'function') {
			indicateurNbLogementCommence.drawChart();

    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
				indicateurNbLogementCommence.drawChart();

            });
	}	
	
</script>	