<script>
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}	
	{{#features}}

		const chart_data = JSON.parse('{{{chart_data}}}')

	{{/features}}	
	
    var indicateurPrixMoyen = {};
    
	var indicateurPrixMoyen = {};
 	indicateurPrixMoyen.drawChart = function (data) {
			var ctx3 = document.getElementById("Chart");
			var ChartTxEvolPop = new Chart(ctx3, {
			   type: 'line', // ou 'bar' si tu préfères un histogramme
			    data: chart_evolpop,
			    options: {
			      responsive: true,
			      plugins: {
			        title: {
			          display: true,
			          text: 'Évolution de la population municipale'
			        }
			      },
			      scales: {
			        y: {
			          title: {
			            display: true,
			            text: 'Prix moyen'
			          },
			          beginAtZero: false
			        },
			        x: {
			          title: {
			            display: true,
			            text: 'Année'
			          }
			        }
			      }
			    }
			});
	};
	 if  (typeof Chart === 'function') {
			indicateurPrixMoyen.drawChart();

    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
				indicateurPrixMoyen.drawChart();
            });
	}	
	
</script>	