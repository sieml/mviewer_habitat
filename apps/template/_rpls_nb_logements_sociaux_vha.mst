{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">			
	
					
					<div class="col-xs-2">
					    <img src="./apps/template/img/loger.png"
					         title="Cliquez pour agrandir cette image"
					         style="width:60px; display:block; margin: 0 auto;">
					    <div class="number" style="margin-top:5%; text-align:center;">{{nb_logements_sociaux}}</div>
					    <div class="title-number" style="text-align:center;">
					        <p>Nombre de logements sociaux</p>
					    </div>
					    <div class="title-number" style="text-align:center;">
					        <p>{{part_logements_sociaux}}% des logements sociaux à l'échelle de {{nom_officiel_comp}} ()</p>
					    </div>							
					</div>

    				<div class="col-xs-4" >
    					<canvas id="ChartTxLogSociaux"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					<!--
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Taux de logements sociaux</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}, {{millesime}}</i></br></p></br>
    					-->
    					</div> 
    				</div>
    				
    				<!--
					<div class="col-xs-4" >
						<canvas id="ChartBailleurs"></canvas>
						<div style="margin-top:10px; text-align:center">
						    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Nombre de logements par bailleurs ({{nom_officiel_comp}}, 2024)</b></p></br>
						</div> 
					</div>
					-->




    				<div class="col-xs-5" style="margin-left:3%;">
    					<canvas id="ChartEvol"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					<!--
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Evolution du nombre de logements sociaux</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; margin-top:-8px;"><i>{{nom_officiel}}</i></br></p></br>
    						-->
    					</div> 
    				</div>


					<div class="col-xs-2" >
						<div id="ChartBailleurs">{{{tableau_html_bailleurs}}}</div>
					</div>



				</div>
				<div class="row">	
					<div class="title-number" style="text-align:left; padding-left:30px;">
							<p><i style="font-size:10px; text-align:center; font-family:'roboto_regular'; color:#777;">{{nom_officiel}} - {{millesime}} - Source : RPLS</i></p>
						</div>
				</div>

			</div>
		</div>
	</div>

</div>	

{{/features}}

