<script>

var chartInstance = null;

var tx_logements_sociaux=[];
var tx_logements_sociaux_comp=[];
var nom_officiel=[];
var nom_officiel_comp=[];

{{#features}}
tx_logements_sociaux.push('{{tx_logements_sociaux}}');
tx_logements_sociaux_comp.push('{{tx_logements_sociaux_comp}}');
nom_officiel.push('{{nom_officiel}}');
nom_officiel_comp.push('{{nom_officiel_comp}}');

chart_data = {{{chart_nb_tx_log_sociaux}}};

{{/features}}
	var indicateurTxLogementsSociaux = {};
	indicateurTxLogementsSociaux.getData = function() {
		var data = {ChartTxLogSociaux: {labels:[nom_officiel,nom_officiel_comp], data: {datasets: [[tx_logements_sociaux[0],tx_logements_sociaux_comp[0]]]}}};
		indicateurTxLogementsSociaux.drawChart(data);
	};

	indicateurTxLogementsSociaux.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartTxLogSociaux");
		
			var ChartTxLogSociaux = new Chart(ctx2, {
			type: 'bar',
			data: {
				labels: data.ChartTxLogSociaux.labels,
				datasets: [{
							label: 'Taux de logements sociaux',
							backgroundColor: "#518299",
							borderColor: "#518299",
							borderWidth: 1,
							borderSkipped:'left',
							data: data.ChartTxLogSociaux.data.datasets[0]
							}]
			},
			options: {
			  responsive: true,
			  maintainAspectRatio: false
			}
		});  
	};
	

	/*
	var indicateurChartBailleurs = {};
 	indicateurChartBailleurs.drawChart = function (data) {
			var ctx3 = document.getElementById("ChartBailleurs");
			var ChartTxBailleurs = new Chart(ctx3, {
			   type: 'bar', // ou 'bar' si tu préfères un histogramme
			    data: chart_data,
			    options: {
			      responsive: true,
			      plugins: {
			        title: {
			          display: true,
			          text: 'Nombre de logements par bailleurs'
			        }
			      },
			      scales: {
			        y: {
			          title: {
			            display: true,
			            text: 'Proportion'
			          },
			          beginAtZero: false
			        },
			        x: {
			          title: {
			            display: true,
			            text: 'Année'
			          }
			        }
			      }
			    }
			  });
	};
	*/


var chartInstance = null;
  var indicateurEvol = {};
  /*
  indicateurEvol.drawChart = function (data) {
    var ctx3 = document.getElementById("ChartEvol");

    if (!ctx3 || !data) {
      console.warn("Canvas ou données manquantes");
      return;
    }
    if (chartInstance) {
        chartInstance.destroy();
        chartInstance = null; // Détruire l'ancien graphique avant de recréer
      }


     chartInstance = new Chart(ctx3, {
      type: 'line',
      data: data,
      options: {
        responsive: true,
        plugins: {
          title: {
            display: true,
            text: 'Evolution du nombre de logements sociaux'
          }
        },
      }
    });
  };
*/
indicateurEvol.drawChart = function (data) {
    var ctx3 = document.getElementById("ChartEvol");

    if (!ctx3 || !data) {
        console.warn("Canvas ou données manquantes");
        return;
    }
    if (chartInstance) {
        chartInstance.destroy();
        chartInstance = null;
    }

    chartInstance = new Chart(ctx3, {
        type: 'line',
        data: data,
        options: {
            responsive: true,
            plugins: {
                title: {
                    display: true,
                    text: 'Evolution du nombre de logements sociaux et du taux'
                }
            },
            scales: {
                y: {
                    type: 'linear',
                    position: 'left',
                    title: {
                        display: true,
                        text: 'Nb logements sociaux'
                    }
                },
                y2: {
                    type: 'linear',
                    position: 'right',
                    title: {
                        display: true,
                        text: 'Taux (%)'
                    },
                    grid: {
                        drawOnChartArea: false
                    }
                }
            }
        }
    });
};


	if  (typeof Chart === 'function') {
			indicateurTxLogementsSociaux.getData();
			//indicateurChartBailleurs.drawChart()
			indicateurEvol.drawChart(chart_data)

    } else {
      $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
			  indicateurTxLogementsSociaux.getData();
			  //indicateurChartBailleurs.drawChart()
			  indicateurEvol.drawChart(chart_data)

      });
	}	
	
</script>