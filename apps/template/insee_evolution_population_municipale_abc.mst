
{{#features}}
<div id="CarouselConfLog" class="carousel slide" data-ride="carousel" data-interval="false">

	<div class="title-feature" style="padding-top:8px;">{{nom_officiel}}</div>
	
	<div class="carousel-inner" style="margin-top:-2%;">
		<div class = "item active">
			<div class="container" style="padding-left:0!important;margin-left:0!important;margin-bottom:10%;overflow:hidden;">
				<div class="row">			
					<div class="col-xs-2">
						<img class="img-responsive" src="./apps/template/img/population.png" style="max-width:50%;margin: 0 auto;">
						<div class="number" style="margin-top:5%;text-align:center;">{{tx_evol_pop}}%</div>
						<div class="title-number style="color: #354753;text-align:center;"">
							<p>Taux d'évolution annuel moyen de la population sur la période</p>
						</div>
						<div class="title-number" style="text-align:center;">
							<p>{{tx_evol_pop_comp}}% pour {{nom_officiel_comp}}</p>
						</div>						
					</div>
					<!-- CHIFFRES CLES SOLDE -->
    				<div class="col-xs-4" >
    					<canvas id="ChartTxEvolPop"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Solde naturel et solde migratoire</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; "><i>{{nom_officiel}}, {{serie}}</i></br></p></br>
    					</div> 
    				</div>

    				<!--
					<div class="col-xs-2" >
                        <div class="definition">
    					<div style="font-family:'roboto_bold';color: #2F4455;"> 
    						<img src="apps/template/img/definition.svg" style="width:18px; margin-right:2px; margin-top:-1%;">Solde naturel <i></i>
    					</div>
    					<p style="margin-top:1%;">Le solde naturel est la différence entre le nombre de naissances et le nombre de décès enregistrés au cours d'une période.  
    					</p>
    					<div style="font-family:'roboto_bold';color: #2F4455; margin-top:10%;"> 
    						<img src="apps/template/img/definition.svg" style="width:18px; margin-right:2px; margin-top:-1%;">Solde migratoire<i></i>
    					</div>
    					<p style="margin-top:1%;">Le solde migratoire (ou apparent) est la différence entre le nombre de personnes qui sont entrées sur le territoire et le nombre de personnes qui en sont sorties au cours de l'année.  
    					</p>					
    				</div>	
    				-->	
    				<div class="col-xs-4" >
    					<canvas id="ChartEvolPop"></canvas>
    					<div style="margin-top:10px; text-align:center">
    					    <p class="title2" style="font-size:11px; margin:0px; margin-top:-8px; "><b>Evolution de la population municipale</b></p></br>
    						<p class="title2" style="font-size:11px; margin:0px; "><i>{{nom_officiel}}</i></br></p></br>
    					</div> 
    				</div>

				</div>
			</div>
		</div>
	</div>

</div>		
{{/features}}
