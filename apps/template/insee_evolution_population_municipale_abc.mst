<script>
	var nom_officiel=[];
	{{#features}}
		nom_officiel.push('{{nom_officiel}}');
	{{/features}}

	var nom_officiel_comp=[];
	{{#features}}
		nom_officiel_comp.push('{{nom_officiel_comp}}');
	{{/features}}

	var serie=[];
	{{#features}}
		serie.push('{{serie}}');
	{{/features}}	
	
	var tx_evol_pop=[];
	{{#features}}
		tx_evol_pop.push('{{tx_evol_pop}}');
	{{/features}}	
	
	var tx_evol_naturel=[];
	{{#features}}
		tx_evol_naturel.push('{{tx_evol_naturel}}');
	{{/features}}	
	
	var tx_evol_apparent=[];
	{{#features}}
		tx_evol_apparent.push('{{tx_evol_apparent}}');
	{{/features}}	

	var tx_evol_pop_comp=[];
	{{#features}}
		tx_evol_pop_comp.push('{{tx_evol_pop_comp}}');
	{{/features}}	
	
	var tx_evol_naturel_comp=[];
	{{#features}}
		tx_evol_naturel_comp.push('{{tx_evol_naturel_comp}}');
	{{/features}}	
	
	var tx_evol_apparent_comp=[];
	{{#features}}
		tx_evol_apparent_comp.push('{{tx_evol_apparent_comp}}');
	{{/features}}	

	{{#features}}

		const chart_evolpop = JSON.parse('{{{chart_evolpop}}}')

	{{/features}}	
	
	
	var indicateurTxEvolPop = {};
	indicateurTxEvolPop.getData = function() {
		var data = {ChartTxEvolPop: {labels:["Solde naturel","Solde migratoire"], data: {datasets: [[tx_evol_naturel[0],tx_evol_apparent[0]],[tx_evol_naturel_comp[0],tx_evol_apparent_comp[0]]]}}};
		indicateurTxEvolPop.drawChart(data);
		console.log(data)
	};
	
 	indicateurTxEvolPop.drawChart = function (data) {
			var ctx2 = document.getElementById("ChartTxEvolPop");
			var maxscale = Math.max.apply(this, data.ChartTxEvolPop.data.datasets[0]) / 5;
			maxscale = Math.trunc(maxscale) * 5;
			ctx2.getContext("2d").canvas.width = 100;
			ctx2.getContext("2d").canvas.height = 55;			
			var ChartTxEvolPop = new Chart(ctx2, {
			type: 'bar',
			data: {
				labels: data.ChartTxEvolPop.labels,
				datasets: [
				    {
						label: nom_officiel,
						backgroundColor: "#005EA8",
						borderColor: "#005EA8",
						borderWidth: 1,
						data: data.ChartTxEvolPop.data.datasets[0],
						stack:'Stack 0'
			    	},
				    {
						label: nom_officiel_comp,
						backgroundColor: "#64BE53",
						borderColor: "#64BE53",
						borderWidth: 1,
						data: data.ChartTxEvolPop.data.datasets[1],
						stack:'Stack 1'
			    	},
				]
			},
			 options: {
	           plugins: {
	                tooltip: {
	                    callbacks: {
	                        afterLabel: function (context) {
	                            const label = context.label;
	                            if (label === "Solde naturel") {
	                                return "Le solde naturel est la différence entre le nombre de naissances\n et le nombre de décès enregistrés au cours\n d'une période.";
	                            } else if (label === "Solde migratoire") {
	                                return "Le solde migratoire (ou apparent) est la différence entre\n le nombre de personnes qui sont entrées sur le territoire\n et le nombre de personnes qui en sont sorties au cours de l'année.";
	                            }
	                            return '';
	                        }
	                    }
	                }
	            }

			}
		});  
	};
	var indicateurEvolPop = {};
 	indicateurEvolPop.drawChart = function (data) {
			var ctx3 = document.getElementById("ChartEvolPop");
			var ChartTxEvolPop = new Chart(ctx3, {
			   type: 'line', // ou 'bar' si tu préfères un histogramme
			    data: chart_evolpop,
			    options: {
			      responsive: true,
			      plugins: {
			        title: {
			          display: true,
			          text: ''
			        }
			      },
			      scales: {
			        y: {
			          title: {
			            display: true,
			            text: 'Population'
			          },
			          beginAtZero: false
			        },
			        x: {
			          title: {
			            display: true,
			            text: 'Année'
			          }
			        }
			      }
			    }
			  });
	};




	if  (typeof Chart === 'function') {
		indicateurTxEvolPop.getData();
		indicateurEvolPop.drawChart();

    } else {
        $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
			indicateurTxEvolPop.getData();
			indicateurEvolPop.drawChart();
        });
	}	
	
</script>
