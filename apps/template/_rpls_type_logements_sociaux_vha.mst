<script>
// Initialisation des tableaux 
var tx_logements_sociaux = [];
var tx_logements_sociaux_comp = [];
var nom_officiel = [];

var tx_t1 = [];
var tx_t2 = [];
var tx_t3 = [];
var tx_t4p = [];
var tx_nc = [];
var tx_etud = [];
var tx_indiv = [];
var tx_col = [];

// Boucles Mustache pour remplir les tableaux 
	{{#features}}
	  tx_logements_sociaux.push('{{tx_logements_sociaux}}');
	  tx_logements_sociaux_comp.push('{{tx_logements_sociaux_comp}}');
	  nom_officiel.push('{{nom_officiel}}');
	  tx_t1.push('{{tx_t1}}');
	  tx_t2.push('{{tx_t2}}');
	  tx_t3.push('{{tx_t3}}');
	  tx_t4p.push('{{tx_t4p}}');
	  tx_nc.push('{{tx_nc}}');
	  tx_etud.push('{{tx_etud}}');
	  tx_indiv.push('{{tx_indiv}}');
	  tx_col.push('{{tx_col}}');
	  const chart_data = {{{chart_data_t1t2}}};
	// Conversion d’un champ JSON brut en objet JavaScript 

	{{/features}}

	var indicateurTypologieLogementsSociaux = {};
	indicateurTypologieLogementsSociaux.getData = function() {
		var data = {ChartTypologieLogSociaux: {labels:["T1","T2","T3","T4 et plus"], data:  [tx_t1[0],tx_t2[0],tx_t3[0],tx_t4p[0]  ]}};
		indicateurTypologieLogementsSociaux.drawChart(data);
	};

	var indicateurTypologieLogementsSociaux2 = {};
	indicateurTypologieLogementsSociaux2.getData = function() {
		var data = {ChartTypologieLogSociaux2: {labels:["Individuel","Collectif"], data:  [tx_indiv[0],tx_col[0]  ]}};
		indicateurTypologieLogementsSociaux2.drawChart(data);
	};

	indicateurTypologieLogementsSociaux.drawChart = function (data) {
	    var ctx2 = document.getElementById("ChartTypologie");
	    ctx2.getContext("2d").canvas.width = 100;
	    ctx2.getContext("2d").canvas.height = 55;			

	    var ChartTypologieLogSociaux = new Chart(ctx2, {
	        type: 'doughnut',
	        data: {
	            labels: data.ChartTypologieLogSociaux.labels,
	            datasets: [{
	                label: 'Typologie des logements sociaux',
	                data: data.ChartTypologieLogSociaux.data,  // Un seul tableau de valeurs
	                backgroundColor: [
	                    "#005EA8", // T1
	                    "#B1DBF2", // T2
	                    "#64BE53", // T3
	                    "#F8A100"  // T4 et plus (exemple)
	                ],
	                borderColor: "#ffffff",
	                borderWidth: 1
	            }]
	        },
	        options: {
		        plugins: {
		          title: {
		            display: true,
		            text: 'Typologie des logements sociaux'
		          }
		        },	        
	            responsive: true, 
			    legend: {
			      labels: {
			        font: {
			          size: 10 // Taille de police réduite
			        },
			        boxWidth: 10, // Réduit la taille des carrés de légende
			        padding: 5 // Moins d'espace autour
			      }
			    }
	        }
	    });  
	};
	indicateurTypologieLogementsSociaux2.drawChart = function (data) {
	    var ctx3 = document.getElementById("ChartTypologie2");
	    ctx3.getContext("2d").canvas.width = 100;
	    ctx3.getContext("2d").canvas.height = 55;			

	    var ChartTypologieLogSociaux2= new Chart(ctx3, {
	        type: 'doughnut',
	        data: {
	            labels: data.ChartTypologieLogSociaux2.labels,
	            datasets: [{
	                label: 'Type de construction',
	                data: data.ChartTypologieLogSociaux2.data,  // Un seul tableau de valeurs
	                backgroundColor: [
	                    "#005EA8", // T1
	                    "#64BE53", // T2
	                ],
	                borderColor: "#ffffff",
	                borderWidth: 1
	            }]
	        },
	        options: {
		        plugins: {
		          title: {
		            display: true,
		            text: 'Type de construction'
		          }
		        },
	            responsive: true, 
			    legend: {
			      labels: {
			        font: {
			          size: 10 // Taille de police réduite
			        },
			        boxWidth: 10, // Réduit la taille des carrés de légende
			        padding: 5 // Moins d'espace autour
			      }
			    }
        	}
	    });  
	};

	var chartInstance = null;
	  var indicateurEvol = {};
	  indicateurEvol.drawChart = function (data) {
	    var ctx3 = document.getElementById("ChartEvol");

	    if (!ctx3 || !data) {
	      console.warn("Canvas ou données manquantes");
	      return;
	    }
	    if (chartInstance) {
	        chartInstance.destroy();
	        chartInstance = null; // Détruire l'ancien graphique avant de recréer
	      }


	     chartInstance = new Chart(ctx3, {
	      type: 'line',
	      data: data,
	      options: {
	        responsive: true,
	        plugins: {
	          title: {
	            display: true,
	            text: 'Evolution du nombre de T1-T2'
	          }
	        },
	      }
	    });
	  };

	if  (typeof Chart === 'function') {
			indicateurTypologieLogementsSociaux.getData();
			indicateurTypologieLogementsSociaux2.getData();
			indicateurEvol.drawChart(chart_data)
    } else {
            $.get('https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js', function() {
				indicateurTypologieLogementsSociaux.getData();
				indicateurTypologieLogementsSociaux2.getData();
				indicateurEvol.drawChart(chart_data)
            });
	}	
	
</script>